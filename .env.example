# Postgres connection string — must point to your Neon database.
# Get this from the Neon dashboard: Project > Connect > "Pooled connection".
# It must include `?sslmode=require` at the end.
#
# In Replit: do NOT put this in a .env file. Set it as a Replit Secret
# named DATABASE_URL instead (Tools -> Secrets). Replit injects it into
# process.env automatically; the app reads it the same way either way.
DATABASE_URL=postgresql://<user>:<password>@<your-project>.neon.tech/<database>?sslmode=require
